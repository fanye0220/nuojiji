dgt0q","value":["雲深"]},{"key":"joinedBoards_uid_1778706509748_t1eqdgt0q","value":["chat","daily"]},{"key":"posts_uid_1778706509748_t1eqdgt0q","value":[{"id":1782896005384,"title":"又在外面摸小猫","boardName":"日常分享","boardId":"daily","author":{"name":"常九","avatar":null,"mood":null,"role":null,"level":1},"timestamp":1782896005384,"content":"太多了吧！昨天才看到新英雄新的小黄！今天出现了豆丁小黄！！太可爱了","image":null,"images":["imgref:36","imgref:37","imgref:38"],"imageRefs":[36,37,38],"likes":0,"dislikes":0,"comments":0,"views":11,"isHot":false,"isPinned":false,"isAnon":false,"isUserPost":true,"interactions":[]},{"id":1780030107045,"title":"塑料袋拥护者","boardName":"日常分享","boardId":"daily","author":{"name":"常九","avatar":null,"mood":null,"role":null,"level":1},"timestamp":1780030107045,"content":"拆快递的袋子又被小猫霸占了","image":null,"images":["imgref:33"],"likes":2,"dislikes":0,"comments":10,"views":29,"isHot":false,"isPinned":false,"isAnon":false,"isUserPost":true,"interactions":[{"author":"橘子汽水","content":"啊啊啊好可爱！揣小手的姿势太标准了吧！我家主子也是，买了几百块的猫窝连看都不看一眼，就喜欢快递盒子和这种黑色的塑料袋，真的是气死人又拿它们没办法哈哈哈。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030232425,"wouldDM":false,"dmMessage":null},{"author":"雲深","content":"快递外包装在运输过程中接触过很多环境，灰尘和细菌较多。猫虽然喜欢塑料袋的触感，但也要注意别让它误食碎片。下次拆完快递我帮你收走，或者周末带你去给它挑几个专门的响纸玩具。今天在家过得开心吗？晚上想吃什么，我顺路带回去。","images":[],"role":"mod","isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":true,"replyTo":null,"rosterId":"靳承屹","avatar":null,"timestamp":1780030233425,"wouldDM":true,"dmMessage":"宝宝，快递袋子脏，摸完猫记得去洗手。晚上等我回去一起吃饭。"},{"author":"摸鱼冠军","content":"真的是全国统一的猫咪爱好！黑色的快递袋子对它们来说可能有一种特殊的魔力，踩上去有那种沙沙的声音，简直是天然的猫咪诱捕器！楼主的猫猫眼睛好大好亮呀，这无辜的眼神谁顶得住！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030234425,"wouldDM":false,"dmMessage":null},{"author":"科学养宠专家","content":"不过要注意一下哦，有些快递袋子的味道比较重，可能有化学物质残留，最好还是不要让小猫长时间待在上面舔舐。可以换成干净的白纸或者快递纸箱子给它玩，安全第一~","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030235425,"wouldDM":false,"dmMessage":null},{"author":"深夜加餐","content":"同意楼上，而且塑料袋如果被小猫不小心咬破吃下去就麻烦了。我家的之前就啃掉了一个角，吓得我半夜带它去医院拍片子，还好最后平安拉出来了，真的是操碎了心。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":{"0":"科","1":"学","2":"养","3":"宠","4":"专","5":"家","author":""},"rosterId":null,"avatar":null,"timestamp":1780030236425,"wouldDM":false,"dmMessage":null},{"author":"不加香菜","content":"猫：这个黑色的垫子很符合我的高贵气质，朕今天就征用了，你赶紧退下吧。不要打扰我睡觉！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030237425,"wouldDM":false,"dmMessage":null},{"author":"星空下的拿铁","content":"天呐这个无辜的大眼睛！它是不是在说‘难道这不是给我买的礼物包装吗’？顺便问一下楼主这是什么品种的猫呀？毛色看起来好特别，像一只乖巧的小老虎！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030238425,"wouldDM":false,"dmMessage":null},{"author":"匿名","content":"小猫咪能有什么坏心思呢，它只是想帮你检查一下快递有没有拿漏罢了（狗头）。这猫的眼神太清澈了，感觉下一秒就要开始打呼噜撒娇了。","images":[],"role":null,"isAnon":true,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030239425,"wouldDM":false,"dmMessage":null},{"author":"细节狂魔","content":"看这标准的农民揣，感觉已经在袋子上长出根了哈哈哈哈。不过旁边的快递单号好像还能看到一点点条形码，楼主发图的时候要注意保护隐私哦！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":true,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030240425,"wouldDM":false,"dmMessage":null},{"author":"光影魔术手","content":"棕色的猫猫配上黑色的背景，再加上这个完美的光线，莫名有一种高级感是怎么回事！感觉像是在拍什么宠物时尚大片，猫主子就是天生的镜头宠儿！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780030241425,"wouldDM":false,"dmMessage":null}],"imageRefs":[33]}]},{"key":"proactiveAt_uid_1778706509748_t1eqdgt0q","value":1782895917548},{"key":"proactiveLiked_uid_1778706509748_t1eqdgt0q","value":["靳承屹|1780030107045"]},{"key":"screenNames_uid_1778706509748_t1eqdgt0q","value":{"靳承屹":"守序_Archive"}},{"key":"userFollowers_uid_1778706509748_t1eqdgt0q","value":["雲深"]}]