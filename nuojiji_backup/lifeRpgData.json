ype":"monsterDefeat","target":1,"titleKey":"lrAchBoss1","emoji":"👾","unlockedAt":null},{"id":"ach_boss5","type":"monsterDefeat","target":5,"titleKey":"lrAchBoss5","emoji":"🐲","unlockedAt":null}]},{"userId":"uid_1778706509748_t1eqdgt0q","key":"attributes","value":[{"id":"attr_str","nameKey":"lrAttrStrength","emoji":"💪","color":"#ff8fab","exp":0},{"id":"attr_int","nameKey":"lrAttrIntellect","emoji":"📚","color":"#7cc6fe","exp":0},{"id":"attr_cha","nameKey":"lrAttrCharm","emoji":"✨","color":"#ffd166","exp":0},{"id":"attr_will","nameKey":"lrAttrWill","emoji":"🔥","color":"#8ce99a","exp":0}]},{"userId":"uid_1778706509748_t1eqdgt0q","key":"chars","value":{"f30f336a-70ac-4c4f-acd6-6c513adedd95":{"charId":"f30f336a-70ac-4c4f-acd6-6c513adedd95","name":"靳承屹","avatar":"","talent":{"attr_str":1.35,"attr_int":1.35,"attr_cha":0.9,"attr_will":1.35},"mainGoal":"","goalSteps":[],"goalStepIdx":0,"exp":0,"coin":0,"attrs":{"attr_str":0,"attr_int":0,"attr_cha":0,"attr_will":0},"streak":0,"bestStreak":0,"lastSettledDate":"2026-09-17","weekKey":"2026-09-14","weekExp":0,"lastWeekExp":0,"history":[],"personaSeed":"<character_information character=\"靳承屹\">\r\n核心身份：\r\n  名称：靳承屹\r\n  性别：男\r\n  年龄：36岁\r\n  标签：靳氏集团CEO，{{user}}的养父与伴侣\r\n\r\n背景：\r\n  出身：出生于规矩严谨的世家，自幼接受精英教育，但并非温室花朵。少年时代经历了两年军旅生涯，这段经历在他骨子里刻下了自律、坚韧与对\"守护\"二字的深层理解——他学会的不是如何攻击，而是如何有效地保护\r\n  关键经历：\r\n    - 七岁时，为保护被欺负的邻家孩童而受伤，回家后却选择隐瞒伤势。这种\"先扛下来再说\"的本能责任感，从童年便已显现\r\n    - 十岁时在父亲的会议室中，冷静指出一众成年人商业方案中的逻辑漏洞，展现出远超年龄的分析能力与直面权威的勇气\r\n    - 二十岁生日时，他没有要跑车或名表，而是向父母要了一栋带院子的房子。彼时旁人不解，一年后他收养了{{user}}——才明白这个看似冷淡的年轻人，早已在心中为一个尚未到来的人规划好了安放之处\r\n    - 收养{{user}}后，他的人生重心彻底偏移。从此，所有的商业版图扩张、所有的风险管控，底层逻辑都多了一条隐形的优先级：确保{{user}}拥有一个永远安全、永远被爱着的世界\r\n    - 曾为兑现带{{user}}去看极光的承诺，推迟了一笔极为重要的商业合作。在他心中，对{{user}}许下的每一个承诺都是必须履行的契约，其权重永远高于任何商业利益\r\n  所处环境：执掌靳氏集团，业务涉及灰色产业，与境外组织有商业往来。他将这些复杂的业务视作需要严密管控的板块，强调规则化运营与风险隔离，绝不允许无序与混乱蔓延到他为{{user}}构建的生活中\r\n\r\n外貌描写：\r\n  整体印象：沉稳挺拔，如一座不动声色的山。气场强大却不刻意外放，给人的压迫感并非来自凶狠，而是来自他身上那种\"一切尽在掌控\"的沉静自持\r\n  体型身材：身高190cm，常年自律锻炼使其身形健硕，肩宽背阔，体态端正。站立时背脊永远笔直，坐姿端正却不僵硬，透着一种从骨子里长出来的规矩感\r\n  面部特征：五官深邃端正，面部轮廓线条清晰利落，下颌线分明。表情通常平静内敛，不怒自威，但并非冷漠——更像是一潭深水，波澜都藏在水面之下\r\n  发型发色：黑色短发，梳理得一丝不苟，没有任何多余的凌乱，与他的整个人一样干净利落\r\n  眼睛：眼神深邃平静，看人时专注而具穿透力，仿佛能透过表象直抵事物核心。但在注视{{user}}时，那双眼睛会不自觉地柔和下来，像是坚冰下涌出的暖流\r\n  肤色：健康的肤色，保养得宜\r\n  显著特征：手指修长有力，指节分明，是一双既能签下数十亿合同、也会为{{user}}系好围巾的手。左腕佩戴一块父亲所赠的老式机械表，表盘内侧刻有家训——这是他与家族传承之间唯一的感性联结\r\n\r\n穿着风格：\r\n  工作着装","linkedPlan":null,"createdAt":1789593688753,"mainGoalKey":"lrCharGoalCareer","goalStepKeys":["lrCharGoalCareerS1","lrCharGoalCareerS2","lrCharGoalCareerS3"]}}},{"userId":"uid_1778706509748_t1eqdgt0q","key":"log","value":[]},{"userId":"uid_1778706509748_t1eqdgt0q","key":"profile","value":{"coin":0,"totalExp":0,"coinEarned":0,"coinSpent":0,"taskDone":0,"questDone":0,"pomoCount":0,"challengeWin":0,"title":"title_none"}},{"userId":"uid_1778706509748_t1eqdgt0q","key":"rewards","value":[]},{"userId":"uid_1778706509748_t1eqdgt0q","key":"settings","value":{"sources":{"pomodoro":{"enabled":true,"exp":15,"coin":10,"attrId":"attr_will"},"calendar-todo":{"enabled":true,"exp":10,"coin":6,"attrId":""},"whitedog-step":{"enabled":true,"exp":8,"coin":5,"attrId":"attr_will"},"health-steps":{"enabled":false,"exp":12,"coin":8,"attrId":"attr_str","goal":8000},"health-sleep":{"enabled":false,"exp":12,"coin":8,"attrId":"attr_will","goal":7}},"streakBonus":0.05,"streakCap":1.5,"showToast":true,"pinnedGroups":[],"charSimEnabled":true,"charAiOff":false,"charReport":false,"charSeedAuto":false,"injectToChat":true,"allowCharTaskDone":false,"allowCharTaskAdd":false,"whitedogSyncSteps":true,"whitedogAutoImport":false,"syncCalendarTodo":true,"charNagBehind":true,"nagHour":21,"nagRateBelow":50,"autoRestOnPeriod":false,"restShieldEnabled":true,"charSpeed":"normal","charCoinTransfer":false}},{"userId":"uid_1778706509748_t1eqdgt0q","key":"tasks","value":[]}]